/* Estilos de qcorre. Los colores vienen del tema definido en theme.py. */

Screen {
    background: $background;
    color: $foreground;
    layout: vertical;
}

/* ── Cabecera ─────────────────────────────────────────────── */

#header {
    width: 100%;
    height: 2;
    padding: 1 2 0 2;
}

#brand {
    width: 1fr;
}

#status {
    width: auto;
}

/* ── Paneles ──────────────────────────────────────────────── */

#body {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

Panel {
    border: round $qc-border;
    border-title-color: $qc-muted;
    padding: 0 1;
    background: $background;
}

Panel:focus, Panel:focus-within {
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
}

#projects {
    width: 42%;
    min-width: 36;
    max-width: 60;
}

/* Árbol de proyectos */

#tree {
    background: $background;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#tree:focus {
    background-tint: transparent;
}

#tree > .tree--guides, #tree > .tree--guides-hover, #tree > .tree--guides-selected {
    color: $qc-muted;
}

#tree > .tree--highlight-line {
    background: $surface;
}

#tree > .tree--cursor {
    background: $panel;
    text-style: none;
}

#tree:focus > .tree--cursor {
    background: $primary 22%;
    text-style: none;
}

#git {
    width: 1fr;
}

#git-scroll {
    padding: 1 1 0 1;
    scrollbar-size-vertical: 1;
}

#git-scroll:focus {
    background-tint: transparent;
}

.empty {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: $qc-muted;
}

/* ── Diálogos (confirmación y detalle) ────────────────────── */

ConfirmScreen, InfoScreen, PromptScreen, PickerScreen {
    align: center middle;
    background: $background 75%;
}

#dialog {
    width: 78;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
}

InfoScreen #dialog {
    width: 88;
}

#dialog.danger {
    border: round $error;
    border-title-color: $error;
}

#dialog-body {
    height: auto;
    max-height: 60vh;
    scrollbar-size-vertical: 1;
}

#dialog-keys {
    height: 1;
    margin-top: 1;
}

#dialog-prompt {
    height: 1;
}

PromptScreen #dialog-body {
    max-height: 45vh;
}

/* Lista para elegir (ramas, deshacer) */

#picker-note {
    height: auto;
    margin-bottom: 1;
}

#picker-list {
    height: auto;
    max-height: 60vh;
    background: $surface;
    border: none;
    padding: 0;
    scrollbar-size-vertical: 1;
}

#picker-list > .option-list--option-highlighted {
    background: $primary 22%;
    text-style: none;
}

#picker-list > .option-list--option-disabled {
    color: $qc-muted;
}

#picker-list:focus {
    border: none;
    background-tint: transparent;
}

#dialog-input {
    margin: 0 0 1 0;
    border: round $qc-border;
    background: $background;
    padding: 0 1;
    height: 3;
}

#dialog-input:focus {
    border: round $primary;
}

/* ── Avisos (toasts) ──────────────────────────────────────── */

Toast {
    background: $panel;
    color: $foreground;
}

/* ── Pie con atajos ───────────────────────────────────────── */

HintBar {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $surface;
}
